// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent": {
    "limit_content_width": false
  },
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "mode": "acceptEdits"
      },
      "type": "registry"
    }
  },
  "session": {
    "trust_all_worktrees": true
  },
  "vim_mode": true,
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font Mono"
  },
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "agent_ui_font_size": 18,
  "agent_buffer_font_size": 17,
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "auto_install_extensions": {
    "applescript": true,
    "catppuccin": true,
    "cobalt2": true,
    "cobalt2x2-theme": true,
    "codebabel-ztheme-dark": true,
    "html": true,
    "macos-classic": true,
    "neon-comfy-soft-themes": true,
    "oxocarbon": true,
    "sergio-tech-code-black-theme": true,
    "tokyo-night": true
  },
  "theme": "Tokyo Night Storm",
}

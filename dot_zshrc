# ── Databases ─────────────────────────────────────────────────────
# Credentials live in 1Password; template at ~/.db-secrets.env.tpl
# Secrets are loaded only when a database command is run.

dbload() {
  if [[ -z "$PGPASSWORD" || -z "$CV_SQL_PWD" ]]; then
    eval "$(op inject -i ~/.db-secrets.env.tpl)" || {
      echo "Failed to load database credentials from 1Password." >&2
      return 1
    }
  fi
}

dbenv() {
  dbload || return
  echo "Database credentials loaded into this shell."
}

medicus() {
  dbload || return
  harlequin -a postgres \
    --host "${PGHOST}" \
    --port "${PGPORT}" \
    --dbname "${PGDATABASE}" \
    -U "${PGUSER}" \
    --password "${PGPASSWORD}" \
    --read-only "$@"
}

carevue() {
  dbload || return
  harlequin -a odbc \
    --read-only \
    "Driver=ODBC Driver 18 for SQL Server;Server=tcp:${CV_SQL_SERVER},1433;Database=${CV_SQL_DB};UID=${CV_SQL_UID};PWD=${CV_SQL_PWD};Encrypt=yes;TrustServerCertificate=yes" "$@"
}

msql() {
  dbload || return
  usql "pg://${PGUSER}:${PGPASSWORD}@${PGHOST}:${PGPORT}/${PGDATABASE}" "$@"
}

csql() {
  dbload || return
  usql "sqlserver://${CV_SQL_UID}:${CV_SQL_PWD}@${CV_SQL_SERVER}:1433?database=${CV_SQL_DB}&TrustServerCertificate=true" "$@"
}

warehouse() {
  harlequin -a postgres \
    --host localhost \
    --port 5433 \
    --dbname picu_dw \
    -U picu_user \
    --password changeme \
    --read-only "$@"
}
